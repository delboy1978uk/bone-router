{
  "name": "delboy1978uk/bone-router",
  "description": "Router package for Bone Framework",
  "license": "MIT",
  "authors": [
    {
      "name": "Derek Stephen McLean",
      "email": "delboy1978uk@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "delboy1978uk/barnacle": "^2.3",
    "delboy1978uk/bone-view": "^1.8.0",
    "delboy1978uk/router": "^4.4",
    "laminas/laminas-diactoros": "^3.3"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "boneframework/contracts": "^1.5",
    "delboy1978uk/dev-tools": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Bone\\Router\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bone\\Test\\Router\\": "tests/unit/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpro/grumphp": false
    }
  }
}
